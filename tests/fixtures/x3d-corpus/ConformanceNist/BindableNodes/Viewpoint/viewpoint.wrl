# [Scene] ========== ========== ==========
WorldInfo {
  title "viewpoint.x3d"
}
Group {
  children [
      Viewpoint {
        description "Rear View"
        orientation 0 1 0 3.14159
        position 0 0 -10
      }
      Background {
        groundAngle [ 1.57 ]
        groundColor [ 0 0.5 0 0 0.5 0 ]
        skyColor [ 0 0 1 ]
      }
      DEF PROX_SENSOR ProximitySensor {
        size 1000 1000 1000
      }
 ### Warning:  no ROUTE found for ProximitySensor output
  ]
}
